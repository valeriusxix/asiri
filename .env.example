# Copy to .env (repo root). Every value below works as-is for the mock demo.

# App
APP_NAME=Asiri
FUND_NAME=Community Relief Fund
# The fund's main display currency: NGN | USD | GBP | CAD. Payouts can be made in any of the four.
FUND_CURRENCY=USD
FUND_DESCRIPTION=Private, fast support for medical, legal and emergency needs.
PORT=8787
# Used to build claim links. Dev (npm run dev): http://localhost:5173. Single-port (npm start): http://localhost:8787.
# To open links on a phone, use this machine's LAN IP or the public HTTPS URL.
# On Render, leave it unset: claim links then use RENDER_EXTERNAL_URL (docs/DEPLOY_RENDER.md).
PUBLIC_WEB_URL=http://localhost:5173
NODE_ENV=development
# Enables simulated cash-out + simulated card donations
DEMO_MODE=true

# Auth (single organizer for the MVP)
ADMIN_EMAIL=organizer@example.com
ADMIN_PASSWORD=change-me-now
# At least 32 characters. Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-64-random-hex-chars-0000000000000000000000000000

# Storage (relative paths resolve against the repo root)
DATABASE_PATH=./data/asiri.db

# Zcash
# mock | zingo
ZCASH_MODE=mock
# testnet | mainnet
ZCASH_NETWORK=testnet
# Required when ZCASH_MODE=zingo. Verified testnet server (docs/ZINGO_NOTES.md): https://testnet.zec.rocks:443
LIGHTWALLETD_URL=
ZINGO_CLI_PATH=zingo-cli
TREASURY_DATA_DIR=./data/treasury
# Reserved per payout to cover the ZIP-317 fee
FEE_BUFFER_ZAT=20000
# Optional: if set, demo cash-outs send real funds here
OFFRAMP_ZCASH_ADDRESS=
SYNC_INTERVAL_SECONDS=60

# Claims
CLAIM_LINK_TTL_DAYS=14
PIN_MAX_ATTEMPTS=5
CLAIM_TOKEN_TTL_MINUTES=15

# Pricing
# coingecko | fixed
PRICE_SOURCE=coingecko
# Price of 1 ZEC in each currency, used when PRICE_SOURCE=fixed or CoinGecko is unavailable (per currency).
# PLACEHOLDERS, NOT MARKET PRICES: replace all four with the day's rates before a demo.
FIXED_ZEC_NGN=1000000
FIXED_ZEC_USD=1000
FIXED_ZEC_GBP=1000
FIXED_ZEC_CAD=1000

# AI reports (optional; template fallback if empty)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Optional Anthropic-compatible gateway base URL; empty = SDK default
ANTHROPIC_BASE_URL=
